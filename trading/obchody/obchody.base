filters:
  and:
    - file.inFolder("trading/obchody")
    - 'typ == "obchod"'
properties:
  symbol:
    displayName: Symbol
  smer:
    displayName: Smer
  vstup:
    displayName: Vstup
  stopka:
    displayName: Stopka
  vystupna_hranica:
    displayName: Vystupna hranica
  riziko_usd:
    displayName: Riziko USD
  stav:
    displayName: Stav
  datum_vstupu:
    displayName: Datum vstupu
  vysledok_r:
    displayName: Vysledok
views:
  - type: table
    name: Obchody
    order:
      - file.name
      - symbol
      - smer
      - vstup
      - stopka
      - vystupna_hranica
      - vysledok_r
      - riziko_usd
      - stav
      - datum_vstupu
